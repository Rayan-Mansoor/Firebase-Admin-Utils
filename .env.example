# A real project: its service account key (keep it under ./secrets/, which git ignores)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/<your-service-account.json>

# The default Storage bucket, when it isn't <project-id>.appspot.com
# (projects created since late 2024 use <project-id>.firebasestorage.app)
# FIREBASE_STORAGE_BUCKET=

# Only for scripts/stripe
STRIPE_API_KEY=sk_test_********************************

# The local emulators instead of a real project (no key needed). Start them with
# `npm run emulators`, then uncomment:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# GCLOUD_PROJECT=demo-firebase-admin-utils
